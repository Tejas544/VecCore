# The source tree is edited on Windows and built/executed inside WSL2 (D2).
# Without this, git's autocrlf gives scripts/fetch_sift.sh CRLF endings, so its
# shebang ends in a carriage return and bash reports:
#
#     /usr/bin/env: 'bash^M': No such file or directory
#
# which names neither the file nor the real cause. Force LF everywhere; every
# consumer of this repo is a Linux toolchain.
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.cpp  text eol=lf
*.hpp  text eol=lf
*.in   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf

# Datasets are binary and must never be line-ending translated. This half
# matters more than it looks: CRLF translation of a vector file corrupts it
# silently, and it would present as P-01 -- a completely unrelated diagnosis.
*.fvecs  binary
*.ivecs  binary
*.tar.gz binary
